  "facts": [
    {
      "id": "I1",
      "statement": "inversion in N with radius sqrt 2 sends each sampled floor point onto the unit sphere, and back to itself",
      "cases_checked": 275,
      "result": true
    },
    {
      "id": "I2",
      "statement": "the lift of each row circle lies in the plane computed for it (29 rational points per circle)",
      "cases_checked": 841,
      "result": true
    },
    {
      "id": "B1",
      "statement": "every nested circle on the dome passes through N",
      "cases_checked": 9,
      "result": true
    },
    {
      "id": "B2",
      "statement": "every two nested circles touch, and they touch at N",
      "cases_checked": 36,
      "result": true
    },
    {
      "id": "B3",
      "statement": "consecutive circles of the chain touch, at the lift of the floor contact point",
      "cases_checked": 28,
      "result": true
    },
    {
      "id": "B4",
      "statement": "every chain circle touches both boundary circles of its crescent and misses N",
      "cases_checked": 58,
      "result": true
    },
    {
      "id": "B5",
      "statement": "chain circles that are not neighbours are disjoint",
      "cases_checked": 378,
      "result": true
    },
    {
      "id": "B6",
      "statement": "the chain is symmetric and its circles shrink strictly toward N; the nested circles shrink toward N",
      "cases_checked": 21,
      "result": true
    },
    {
      "id": "A1",
      "statement": "the nested circles become straight lines, all parallel (normal (0,1)), equally spaced by 1",
      "cases_checked": 8,
      "result": true
    },
    {
      "id": "A2",
      "statement": "the chain becomes one straight row of equal circles: equal radii 1/2, collinear centres, neighbours at distance 1 = 2r",
      "cases_checked": 29,
      "result": true
    },
    {
      "id": "A3",
      "statement": "the two boundary circles become the lines v = 11/10 and v = 21/10, and each row circle touches both",
      "cases_checked": 58,
      "result": true
    },
    {
      "id": "R1",
      "statement": "N, each contact point of the chain on the dome and the matching contact point of the row on the floor are collinear, the dome point between the other two",
      "cases_checked": 28,
      "result": true
    }
  ],
